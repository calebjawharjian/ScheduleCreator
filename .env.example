# Copy to .env (gitignored) and fill in ONE key.
#
# Narration picks the first key it finds, free providers first, and falls back
# to deterministic summaries when it finds none -- so leaving this file empty
# is a supported way to run.

# Groq -- free tier, very fast          https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini -- free tier            https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter -- some free models        https://openrouter.ai/keys
OPENROUTER_API_KEY=

# DeepSeek -- very cheap, not free      https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Anthropic -- always billed            https://console.anthropic.com
ANTHROPIC_API_KEY=

# Force a provider instead of auto-selecting. Also the only way to reach a
# local Ollama, which needs no key and so cannot be detected:
#   NARRATOR_PROVIDER=ollama
# NARRATOR_PROVIDER=

# Override the default model for whichever provider is chosen. Useful when a
# provider retires a model name.
# NARRATOR_MODEL=
